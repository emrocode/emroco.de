{
  "imports": {
    "@/": "./",
    "@emrocode/umbra": "npm:@emrocode/umbra@1.0.2",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.1.4/",
    "lume/icons/": "https://deno.land/x/lume_icon_plugins@v0.2.4/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "@std/dotenv": "jsr:@std/dotenv@0.225.7",
    "shiki/": "https://deno.land/x/lume_shiki@0.0.20/",
    "contentful": "npm:contentful@11.12.7",
    "date-fns": "npm:date-fns@4.4.0/locale/es",
    "aos": "npm:aos@2.3.4",
    "@types/aos": "npm:@types/aos@3.0.8"
  },
  "tasks": {
    "lume": "deno run -A lume/cli.ts",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  },
  "lock": false,
  "minimumDependencyAge": "0",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "types": ["lume/types.ts"]
  },
  "allowScripts": {
    "deny": ["npm:sharp"]
  }
}
