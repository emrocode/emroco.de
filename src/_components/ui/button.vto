{{ if href }}
  <a class="button {{ variant }}" href="{{ href }}">
    {{ if icon }}{{ icon |> phosphor }}{{ /if }}
    {{ text }}
  </a>
{{ else }}
  <button class="button {{ variant }}" onclick="{{ callback }}">
    {{ if icon }}{{ icon |> phosphor }}{{ /if }}
    {{ text }}
  </button>
{{ /if }}
