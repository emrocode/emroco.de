---
MAX_PROFILES: 4
---

<ul class="menu menu--{{ size }}">
  {{ for item of menu }}
    {{ set isActive = url === item.path }}
    <li class="menu__item">
      <a
        class="menu__link {{ isActive ? 'menu__link--active' : '' }}"
        href="{{ item.path }}"
      >
        {{ item.key }}
      </a>
    </li>
  {{ /for }}
  <li class="menu__divider {{ size === 'large' ? 'menu__divider--vertical' : '' }}">
  </li>
  <ul class="menu__social">
    {{ for prof of profiles |> slice(0,MAX_PROFILES) }}
      <li class="menu__item">
        <a title="{{ prof.platform }}" href="{{ prof.url }}" class="menu__link">
          {{ prof.icon |> phosphor }}
        </a>
      </li>
    {{ /for }}
  </ul>
</ul>
