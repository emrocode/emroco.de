---
MAX_PROFILES: 3
---

<ul class="menu menu--{{ size }}">
  {{ for item of menu }}
    {{ set isActive = url === item.path }}
    <li class="menu__item">
      <a
        class="menu__link {{ isActive ? 'menu__link--active' : '' }}"
        href="{{ item.path }}"
      >
        {{ item.key }}
      </a>
    </li>
  {{ /for }}
  <li class="menu__divider {{ size === 'large' ? 'menu__divider--vertical' : '' }}">
  </li>
  <ul class="menu__social">
    <li class="menu__item">
      <a title="Mail" href="mailto:{{ about.email }}" class="menu__link">
        {{ "paper-plane-tilt" |> phosphor }}
      </a>
    </li>
    {{ for p of profiles |> slice(0,MAX_PROFILES) }}
      <li class="menu__item">
        <a title="{{ p.platform }}" href="{{ p.url }}" class="menu__link">
          {{ `${p.platform}-logo` |> toLowerCase |> phosphor }}
        </a>
      </li>
    {{ /for }}
  </ul>
</ul>
